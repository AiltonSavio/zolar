# The merchant service (zolar-merchant) and the customer's wallet helper (zolar-wallet).
VITE_MERCHANT_URL=http://127.0.0.1:7979
VITE_WALLET_URL=http://127.0.0.1:7878
VITE_ITEM_ID=ga
# Explorer links: devnet or mainnet-beta.
VITE_CLUSTER=devnet

# Existing checkout is the default. Set to vending for the machine checkout.
VITE_CHECKOUT_MODE=checkout
# Vending is Zcash testnet + Solana devnet only. All settings below are public.
VITE_VENDING_MACHINE=
VITE_VENDING_PROGRAM=
VITE_VENDING_ADDRESS=
VITE_VENDING_RPC=https://api.devnet.solana.com
VITE_PROVER_URL=http://127.0.0.1:8080
# Authoritative machine-setup artifact; the fixture ABI is never a deployment ABI.
VITE_VENDING_ABI_URL=/vending-abi.json
