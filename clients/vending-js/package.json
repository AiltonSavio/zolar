{
  "name": "@zolar/vending-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=neutral --format=esm --packages=external --outfile=dist/index.js"
  },
  "dependencies": {
    "@solana/kit": "8.5.0",
    "@solana/program-client-core": "8.5.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
